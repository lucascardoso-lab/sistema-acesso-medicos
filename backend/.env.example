APP_ENV=development

# mysql+pymysql://usuario:senha@localhost/nome_banco
DATABASE_URL=mysql+pymysql://root:senha@localhost/sistema_medicos

SECRET_KEY=troque-esta-chave-por-uma-aleatoria-e-secreta
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Windows: C:\sistema-medicos\uploads | Linux: /var/lib/sistema-medicos/uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=5242880

# Configuração de SMTP: não é mais feita por variável de ambiente — é
# cadastrada pelo administrador em Configurações, na área administrativa
# (senha armazenada criptografada no banco, nunca em texto puro).

# Aceita múltiplas origens separadas por vírgula (ex.: localhost + IP da
# máquina na rede local, útil para testar de outros dispositivos em dev)
FRONTEND_URL=http://localhost:5173
